/* Status window: top-left, below the legacy map name bar. Shared styles live in theme.rcss. */

#status {
    position: absolute;
    left: 6dp;
    top: 34dp;
    width: 230dp;
    padding: 7dp 8dp 8dp 8dp;
}

/* ---- Header: level badge + name ---------------------------------------------------------- */

.status-header {
    display: flex;
    align-items: center;
    margin-bottom: 6dp;
}

.level-badge {
    width: 26dp;
    height: 26dp;
    margin-right: 8dp;
    border: 1dp #6f9bd1;
    border-radius: 13dp;
    decorator: vertical-gradient(#24364f #0e1520);
    text-align: center;
    line-height: 26dp;
    font-size: 11dp;
    font-weight: bold;
    color: #eef2f7;
}

.identity {
    flex: 1;
}

/* ---- Stat rows: label + gauge ------------------------------------------------------------ */

.stat {
    display: flex;
    align-items: center;
    margin-top: 3dp;
}

.stat .gauge {
    flex: 1;
}

.stat-label {
    width: 20dp;
    font-size: 9dp;
    font-weight: bold;
    font-effect: outline(1dp #000000cc);
}

.shield  .stat-label { color: #ffd24a; }
.life    .stat-label { color: #ff6b6b; }
.mana    .stat-label { color: #62b3ff; }
.ability .stat-label { color: #4fd8a6; }
