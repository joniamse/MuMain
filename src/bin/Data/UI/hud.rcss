/* Modern HUD. Sizes are in dp: 1dp = 1px at a 720px-high window, scaled with the window. */

body {
    width: 100%;
    height: 100%;
    font-family: "Liberation Sans";
    font-size: 13dp;
    color: #e9dcc0;
    pointer-events: none;
}

/* Centred above the legacy bottom bar while both HUDs coexist. */
#vitals {
    position: absolute;
    left: 50%;
    margin-left: -140dp;
    bottom: 92dp;
    width: 280dp;
    padding: 10dp 12dp 12dp 12dp;
    background-color: #0c0a0ed9;
    border: 1dp #9a7a3a;
    border-radius: 6dp;
}

.header {
    display: block;
    height: 20dp;
    margin-bottom: 4dp;
    border-bottom: 1dp #9a7a3a66;
}

.name {
    float: left;
    font-weight: bold;
    font-size: 15dp;
    color: #f3d58a;
    font-effect: outline(1dp #000000);
}

.level {
    float: right;
    font-size: 12dp;
    color: #cdbb94;
    line-height: 18dp;
}

.bar {
    display: block;
    position: relative;
    height: 18dp;
    margin-top: 6dp;
    background-color: #1b1519;
    border: 1dp #4a3a22;
    border-radius: 4dp;
}

.bar.small {
    height: 12dp;
}

.fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-radius: 3dp;
}

.life .fill    { decorator: vertical-gradient(#e0484a #7a0f14); }
.mana .fill    { decorator: vertical-gradient(#4f8ff0 #13328a); }
.shield .fill  { decorator: vertical-gradient(#f2e27a #9a7a1a); }
.ability .fill { decorator: vertical-gradient(#7fe08a #1f7a3a); }

.label {
    position: absolute;
    left: 6dp;
    top: 0;
    font-size: 11dp;
    font-weight: bold;
    line-height: 18dp;
    color: #ffffffcc;
    font-effect: outline(1dp #000000);
}

.value {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    text-align: center;
    font-size: 11dp;
    line-height: 18dp;
    color: #ffffff;
    font-effect: outline(1dp #000000);
}

.small .label,
.small .value {
    font-size: 9dp;
    line-height: 12dp;
}
