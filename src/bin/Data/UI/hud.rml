<rml>
<head>
    <title>HUD</title>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="hud.rcss"/>
</head>
<body data-model="hud">
    <div id="status" class="panel">
        <div class="status-header">
            <div class="level-badge">{{level}}</div>
            <div class="identity">
                <div class="text-title">{{name}}</div>
                <div class="text-muted" data-if="master_level > 0">Master Lv. {{master_level}}</div>
                <div class="text-muted" data-if="master_level == 0">Level {{level}}</div>
            </div>
        </div>

        <div class="stat shield">
            <span class="stat-label">SD</span>
            <div class="gauge">
                <div class="gauge-fill" data-style-width="shield_width"></div>
                <div class="gauge-gloss"></div>
                <span class="gauge-value">{{shield}} / {{shield_max}}</span>
            </div>
        </div>
        <div class="stat life" data-class-critical="life_pct < 25">
            <span class="stat-label">HP</span>
            <div class="gauge">
                <div class="gauge-fill" data-style-width="life_width"></div>
                <div class="gauge-gloss"></div>
                <span class="gauge-value">{{life}} / {{life_max}}</span>
            </div>
        </div>
        <div class="stat mana">
            <span class="stat-label">MP</span>
            <div class="gauge">
                <div class="gauge-fill" data-style-width="mana_width"></div>
                <div class="gauge-gloss"></div>
                <span class="gauge-value">{{mana}} / {{mana_max}}</span>
            </div>
        </div>
        <div class="stat ability">
            <span class="stat-label">AG</span>
            <div class="gauge thin">
                <div class="gauge-fill" data-style-width="ability_width"></div>
                <div class="gauge-gloss"></div>
            </div>
        </div>
    </div>
</body>
</rml>
