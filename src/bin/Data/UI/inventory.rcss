/* Modern look of the legacy inventory window. Boxes from the data model are placed in window
   pixels to match the legacy window, which draws the items over this document; the fixed parts
   are placed in % of the panel (190 x 429 legacy units). Fonts are in dp.
   Item frames by kind: normal (steel), high (+7, gold), excellent (green), ancient (cyan). */

#inventory {
    position: absolute;
    decorator: vertical-gradient(#121b29f5 #06090ef5);
    border: 1dp #253246;
    border-radius: 6dp;
}

/* ---- Header: title bar with the set/socket state; the close button sits on its right ------- */

.inv-header {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 9.6%;
    decorator: vertical-gradient(#1f2d42 #111a27);
    border-bottom: 1dp #6f9bd166;
    border-radius: 6dp 6dp 0 0;
    text-align: center;
}

.inv-title {
    margin-top: 5dp;
    font-size: 12dp;
    font-weight: bold;
    letter-spacing: 2dp;
    color: #eef2f7;
    font-effect: outline(1dp #000000aa);
}

.inv-options {
    margin-top: 2dp;
}

.inv-option {
    margin: 0 5dp;
    padding: 0 5dp;
    font-size: 7dp;
    font-weight: bold;
    letter-spacing: 1dp;
    color: #3e4d62;
    border: 1dp #253246;
    border-radius: 3dp;
}

.inv-option.on {
    color: #ffd24a;
    border-color: #ffd24a88;
    background-color: #ffd24a1a;
}

/* ---- Equipment ------------------------------------------------------------------------------- */

.inv-section {
    position: absolute;
    background-color: #03050880;
    border: 1dp #1a2433;
    border-radius: 5dp;
}

.inv-section.equipment {
    left: 3.2%;
    width: 93.6%;
    top: 10.1%;
    height: 36%;
}

.slot {
    position: absolute;
    border: 1dp #263449;
    border-radius: 4dp;
    decorator: vertical-gradient(#0e1621 #070a10);
}

/* Soft highlight on the upper half: a raised, glassy slot. */
.slot-shine {
    position: absolute;
    left: 1dp;
    right: 1dp;
    top: 1dp;
    height: 40%;
    border-radius: 3dp;
    background-color: #ffffff08;
}

.slot-label {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: -5dp;
    text-align: center;
    font-size: 7dp;
    letter-spacing: 1dp;
    color: #34445a;
}

.slot.filled {
    border-color: #3a5070;
    decorator: vertical-gradient(#16222f #0a1018);
}

.slot.high { border-color: #c9a44c; }
.slot.excellent { border-color: #4fd86a; }
.slot.ancient { border-color: #3db8ff; }

/* Worn-out or unusable equipment: the frame turns yellow, orange or red. */
.slot.worn {
    border-color: #ffe14a;
    decorator: vertical-gradient(#2b2710 #0f0d06);
}

.slot.worn-more {
    border-color: #ff9a2e;
    decorator: vertical-gradient(#2e1d0c #100a05);
}

.slot.broken {
    border-color: #ff4d4d;
    decorator: vertical-gradient(#331212 #120707);
}

/* ---- Grid ------------------------------------------------------------------------------------ */

.inv-grid {
    position: absolute;
    display: flex;
    flex-wrap: wrap;
    background-color: #05080c;
    border: 1dp #263449;
}

/* 8 x 8 squares. */
.cell {
    box-sizing: border-box;
    width: 12.5%;
    height: 12.5%;
    border-right: 1dp #101824;
    border-bottom: 1dp #101824;
    decorator: vertical-gradient(#0c121b #080c12);
}

.item {
    position: absolute;
    border: 1dp #34465f;
    border-radius: 3dp;
    decorator: vertical-gradient(#1a2636 #0d141e);
}

.item.high {
    border-color: #c9a44c;
    decorator: vertical-gradient(#2c2512 #110e07);
}

.item.excellent {
    border-color: #4fd86a;
    decorator: vertical-gradient(#132c1b #08130c);
}

.item.ancient {
    border-color: #3db8ff;
    decorator: vertical-gradient(#0f2436 #071019);
}

/* ---- Zen ------------------------------------------------------------------------------------- */

.inv-zen {
    position: absolute;
    left: 6.3%;
    width: 87.4%;
    top: 85.3%;
    height: 5.6%;
    display: flex;
    align-items: center;
    decorator: vertical-gradient(#0b111a #05080c);
    border: 1dp #263449;
    border-radius: 4dp;
}

.zen-coin {
    width: 10dp;
    height: 10dp;
    margin-left: 7dp;
    border-radius: 5dp;
    decorator: vertical-gradient(#ffe38a #b8862a);
    border: 1dp #7a5a1c;
}

.zen-value {
    flex: 1;
    text-align: right;
    font-size: 12dp;
    font-weight: bold;
    color: #96dcff;
    font-effect: outline(1dp #000000aa);
}

.zen-label {
    margin: 0 7dp 0 4dp;
    font-size: 8dp;
    font-weight: bold;
    color: #c9a44c;
}

/* Same tiers as the classic zen colours. */
.inv-zen.mid .zen-value { color: #18c900; }
.inv-zen.high .zen-value { color: #ff9600; }
.inv-zen.max .zen-value { color: #ff3b3b; }

/* ---- Buttons (the legacy window handles their clicks) ------------------------------------- */

.inv-button {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1dp #2f4058;
    border-radius: 4dp;
    decorator: vertical-gradient(#1d2a3c #0e151f);
}

.inv-button-label {
    font-size: 9dp;
    font-weight: bold;
    color: #b9c8dc;
}

.inv-button:hover {
    border-color: #9cc2ee;
    decorator: vertical-gradient(#26364d #121b28);
}

.inv-button:hover .inv-button-label {
    color: #ffffff;
}

/* Close: a plain cross in the title bar. */
.inv-button.exit {
    border-color: #00000000;
    decorator: none;
}

.inv-button.exit .inv-button-label {
    font-size: 14dp;
    font-weight: normal;
    color: #8fa3bd;
}

.inv-button.exit:hover {
    border-color: #ff6b6b88;
    background-color: #ff4d4d22;
}

.inv-button.exit:hover .inv-button-label {
    color: #ff8080;
}

.inv-button.active {
    border-color: #ffd24a;
    decorator: vertical-gradient(#3a3115 #1a1609);
}

.inv-button.active .inv-button-label {
    color: #ffd24a;
}

.inv-button.locked .inv-button-label {
    color: #4a5a70;
}

/* The tooltips of the footer buttons would cover the zen: they open upwards but to the left. */
.inv-button .tooltip {
    left: auto;
    right: 0;
}
